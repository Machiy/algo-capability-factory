# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# 本地环境配置（保留 .env.example）
.env
.env.*
!.env.example

# 内部规划与审计文档：保留在本地工作区，不随仓库提交
PLAN.md
AUDIT.md

# 阶段性归档：暂不纳入版本控制，需要时按原路径取回
_archive/

# 原始数据缓存：可由 scripts/download_data.py 重新生成，不入库
assets/data/raw/

# 运行轨迹与日志（报告、生成代码、图谱样例属于交付物，不忽略）
# outputs/runs/ 是每次运行的临时轨迹；脱敏后的 LLM 对话证据放
# assets/llm_cassettes/，属交付物，不忽略
outputs/runs/
*.log

# 可由 scripts/build_kg.py 重建的二进制运行产物，不入库
outputs/kg/*.db

# pyvis 若回退到本地资源模式会在根目录生成 lib/（当前用内联模式，防止误提交）
/lib/

# 编辑器与系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# CodeBuddy 项目级本地个人配置（不提交；其余 .codebuddy 内容随仓库共享）
.codebuddy/settings.local.json
