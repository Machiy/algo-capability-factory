# 复制为 .env 后填写；全部留空时系统默认使用 --mock 离线模式
# 生效条件：仅在「不带 --mock」运行 CLI / API 时读取本文件；
# 带 --mock 会强制全链路规则模板并忽略 .env，保证离线可复现。
# 只填 LLM_API_KEY 不会产生请求——必须把 LLM_PROVIDER 改为 openai_compat。
# LLM_PROVIDER: mock | openai_compat | cassette
LLM_PROVIDER=mock

# DeepSeek OpenAI 兼容端点（官方：https://api.deepseek.com，也接受 /v1）
LLM_BASE_URL=https://api.deepseek.com
# 官方当前示例模型；deepseek-chat / deepseek-reasoner 为旧名
LLM_MODEL=deepseek-flash
# 生成参数（依据 DeepSeek 官方 Chat Completions / Temperature / Thinking Mode 文档）
LLM_TEMPERATURE=0.0              # Coding/Math 推荐；thinking 模式下不生效
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=180          # LLM 请求超时，与沙箱 60s 互不影响
LLM_REASONING_EFFORT=high        # none | low | high | max
LLM_THINKING=enabled             # enabled | disabled
LLM_CONTEXT_BUDGET_TOKENS=32000  # prompt 拼接的输入 token 上限

# 凭据：仅放 .env / 环境变量，绝不写入仓库、日志或 cassette
# 等价于 DeepSeek 官方示例的 DEEPSEEK_API_KEY
LLM_API_KEY=

# 录制回放（填好 key 后仍保持 provider=mock；录制/真实调用由命令参数一次性覆盖）
FACTORY_LLM_RECORD=false
FACTORY_LLM_CASSETTE_DIR=assets/llm_cassettes

# 运行参数
FACTORY_LOG_LEVEL=INFO
FACTORY_SEED=42
