# GitHub linguist：语言栏按「代码字节数」统计，不按行数。
# outputs/kg/*.html 是 PyVis 生成的可视化交付物，单文件约 700KB，内联了整包
# vis-network JS，会把仓库算成「以 HTML 为主」，掩盖真实的 Python 源码占比。
# 这些文件必须随仓库分发（README 要求浏览器直接打开、断网可用），不能 gitignore，
# 因此用 linguist 属性把它们排除出语言统计，而不是删除或忽略。

outputs/kg/*.html     linguist-generated=true
outputs/kg/*.json     linguist-generated=true
outputs/kg/*.csv      linguist-generated=true
outputs/kg/*.cypher   linguist-generated=true
outputs/kg/*.graphml  linguist-generated=true

# 第三方仓库快照（scorecardpy，MIT）：作为「真实仓库抽取」的输入材料随仓库分发，
# 不是本项目源码，语言统计里不应计入。
assets/repo/**        linguist-vendored=true

# 数据与 LLM 回放文件属于输入材料，同样不计入语言统计。
assets/data/**        linguist-generated=true
assets/llm_cassettes/** linguist-generated=true
