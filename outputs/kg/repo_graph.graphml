      <data key="d0">cap.repo.scorecardpy.scorecardpy.split_df.split_df</data>
      <data key="d1">Capability</data>
      <data key="d2">Split a dataset</data>
      <data key="d3">v1</data>
      <data key="d4">tabular_binary_classification</data>
      <data key="d5">candidate</data>
      <data key="d6">1</data>
      <data key="d9">scorecardpy</data>
