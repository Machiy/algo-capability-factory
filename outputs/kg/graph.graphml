      <data key="d4">tabular_binary_classification</data>
      <data key="d5">active</data>
      <data key="d6">1</data>
      <data key="d15">T3</data>
      <data key="d16">3. 已知数据问题（登记为 T1–T4）</data>
      <data key="d17">T3</data>
      <data key="d18">账单金额为负</data>
      <data key="d19">`BILL_AMT*` 负值记录共 **3,932** 条</data>
      <data key="d20">视为退款/多付，保留符号，不做绝对值化</data>
      <data key="d21">{"实测证据": 3932.0, "编号": 3.0}</data>
    </node>
    <node id="cap.data_dictionary.T3b">
      <data key="d0">cap.data_dictionary.T3b</data>
