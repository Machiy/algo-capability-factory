      <data key="d10">{"名称": "UCI Default of Credit Card Clients", "标签": "`default.payment.next.month`，1 = 违约，0 = 正常", "样本量": "30,000 行 × 25 列（23 特征 + 1 标签 + 1 标识）", "正例": "6,636（22.12%，下月违约）", "观测期": "2005 年 4 月 – 2005 年 9 月", "负例": "23,364（77.88%）"}</data>
      <data key="d11">default.payment.next.month</data>
      <data key="d12">["ID", "default.payment.next.month"]</data>
      <data key="d13">["SEX", "AGE", "EDUCATION", "MARRIAGE"]</data>
      <data key="d14">temporal_holdout</data>
