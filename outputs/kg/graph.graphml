      <data key="d3">v1</data>
      <data key="d4">tabular_binary_classification</data>
      <data key="d5">active</data>
      <data key="d6">1</data>
      <data key="d15">T2b</data>
      <data key="d16">3. 已知数据问题（登记为 T1–T4）</data>
      <data key="d17">T2b</data>
      <data key="d18">还款状态含未文档化值</data>
      <data key="d19">`PAY_0` 实测范围 `[-2, 8]`，字典未说明 -2 含义</data>
      <data key="d20">保留为独立类别，不做简单裁剪</data>
      <data key="d21">{"编号": 2.0}</data>
    </node>
    <node id="cap.data_dictionary.T3">
