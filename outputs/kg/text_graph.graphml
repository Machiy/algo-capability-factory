    <node id="cap.sms_data_dictionary.ST1">
      <data key="d0">cap.sms_data_dictionary.ST1</data>
      <data key="d1">Capability</data>
      <data key="d2">[ST1] 大小写与标点不统一</data>
      <data key="d3">v1</data>
      <data key="d4">tabular_binary_classification</data>
      <data key="d5">active</data>
      <data key="d6">1</data>
      <data key="d10">ST1</data>
      <data key="d11">2. 已知数据问题</data>
      <data key="d12">ST1</data>
      <data key="d13">大小写与标点不统一</data>
      <data key="d14">统一小写后再做 TF-IDF，数字保留</data>
      <data key="d15">{"编号": 1.0}</data>
    </node>
    <node id="cap.sms_data_dictionary.ST2">
      <data key="d0">cap.sms_data_dictionary.ST2</data>
      <data key="d1">Capability</data>
      <data key="d2">[ST2] 正文含电话号码与短链接</data>
      <data key="d3">v1</data>
      <data key="d4">tabular_binary_classification</data>
      <data key="d5">active</data>
      <data key="d6">1</data>
      <data key="d10">ST2</data>
      <data key="d11">2. 已知数据问题</data>
      <data key="d12">ST2</data>
      <data key="d13">正文含电话号码与短链接</data>
      <data key="d14">替换为 `phone` / `url` 占位符，避免记忆具体号码</data>
      <data key="d15">{"编号": 2.0}</data>
    </node>
    <node id="cap.sms_data_dictionary.ST3">
      <data key="d0">cap.sms_data_dictionary.ST3</data>
      <data key="d1">Capability</data>
      <data key="d2">[ST3] 极短文本与重复文本</data>
      <data key="d3">v1</data>
      <data key="d4">tabular_binary_classification</data>
      <data key="d5">active</data>
      <data key="d6">1</data>
      <data key="d10">ST3</data>
      <data key="d11">2. 已知数据问题</data>
      <data key="d12">ST3</data>
      <data key="d13">极短文本与重复文本</data>
      <data key="d14">长度 &lt; 3 的样本剔除；重复文本只在训练集保留一份</data>
      <data key="d15">{"处理方式": 3.0, "编号": 3.0}</data>
    </node>
    <node id="cap.sms_data_dictionary.ST4">
      <data key="d0">cap.sms_data_dictionary.ST4</data>
      <data key="d1">Capability</data>
      <data key="d2">[ST4] 标签分布偏斜</data>
      <data key="d3">v1</data>
      <data key="d4">tabular_binary_classification</data>
      <data key="d5">active</data>
      <data key="d6">1</data>
      <data key="d10">ST4</data>
      <data key="d11">2. 已知数据问题</data>
      <data key="d12">ST4</data>
      <data key="d13">标签分布偏斜</data>
      <data key="d14">spam 13.4%，评估用 macro-F1，必要时在 Pipeline 内做类别权重</data>
      <data key="d15">{"编号": 4.0}</data>
    </node>
    <node id="evidence.sms_failure_review">
      <data key="d0">evidence.sms_failure_review</data>
      <data key="d1">Evidence</data>
