{
  "components": {
    "schemas": {
      "CandidateSummary": {
        "description": "单个候选的摘要：指标按任务透出，分类 / 文本 / 回归都适用。\n\n早期版本固定返回 ``auc``，换成文本或回归任务时该字段恒为 ``null``；\n现在给出完整 ``metrics``，并用 ``primary_metric`` 指明当前任务的主指标。",
        "properties": {
          "metrics": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": "Metrics",
            "type": "object"
          },
          "model_family": {
            "title": "Model Family",
            "type": "string"
          },
          "passed": {
            "title": "Passed",
            "type": "boolean"
          },
          "plan_id": {
            "title": "Plan Id",
            "type": "string"
          },
          "primary_metric": {
            "default": "",
            "title": "Primary Metric",
            "type": "string"
          },
          "primary_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Primary Value"
          },
          "repair_rounds": {
            "default": 0,
            "title": "Repair Rounds",
            "type": "integer"
          }
        },
        "required": [
          "plan_id",
          "model_family",
          "passed"
        ],
        "title": "CandidateSummary",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "RunRequest": {
        "description": "``POST /run`` 请求体。",
        "properties": {
          "mock": {
            "default": false,
            "description": "强制规则模板路径",
            "title": "Mock",
            "type": "boolean"
          },
          "run_id": {
            "default": "api",
            "description": "运行标识，用于产物命名（字母/数字/./_/-，1–64 位，禁止 ..）",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
            "title": "Run Id",
            "type": "string"
          },
          "spec": {
            "description": "自然语言能力描述",
            "title": "Spec",
            "type": "string"
          }
        },
        "required": [
          "spec"
        ],
        "title": "RunRequest",
        "type": "object"
      },
      "RunResponse": {
        "description": "``POST /run`` 响应体，字段取自 ``RunTrace``。",
        "properties": {
          "candidate_count": {
            "title": "Candidate Count",
            "type": "integer"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/CandidateSummary"
            },
            "title": "Candidates",
            "type": "array"
          },
          "interpreter_source": {
            "title": "Interpreter Source",
            "type": "string"
          },
          "kg_mode": {
            "title": "Kg Mode",
            "type": "string"
          },
          "passed": {
            "title": "Passed",
            "type": "boolean"
          },
          "repair_count": {
            "title": "Repair Count",
            "type": "integer"
          },
          "report_path": {
            "title": "Report Path",
            "type": "string"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "test_metrics": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": "Test Metrics",
            "type": "object"
          }
        },
        "required": [
          "run_id",
          "passed",
          "interpreter_source",
          "kg_mode",
          "candidate_count",
          "repair_count",
          "candidates",
          "report_path"
        ],
        "title": "RunResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "基于 AI Agent 的算法能力工厂：提交自然语言能力描述，返回生成代码、四层验证结论与图谱沉淀。",
    "title": "AlgoCap Factory API",
    "version": "1.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "健康检查"
      }
    },
    "/run": {
      "post": {
        "operationId": "run_run_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "跑通 a–g 七步闭环"
      }
    },
    "/templates": {
      "get": {
        "operationId": "templates_templates_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "title": "Response Templates Templates Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "已注册算法模板"
      }
    }
  }
}