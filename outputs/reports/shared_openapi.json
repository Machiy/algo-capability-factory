{
  "components": {
    "schemas": {
      "CandidateSummary": {
        "description": "单个候选的摘要：指标按任务透出，分类 / 文本 / 回归都适用。\n\n早期版本固定返回 ``auc``，换成文本或回归任务时该字段恒为 ``null``；\n现在给出完整 ``metrics``，并用 ``primary_metric`` 指明当前任务的主指标。",
        "properties": {
          "metrics": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": "Metrics",
            "type": "object"
          },
          "model_family": {
            "title": "Model Family",
            "type": "string"
          },
          "passed": {
            "title": "Passed",
            "type": "boolean"
          },
          "plan_id": {
            "title": "Plan Id",
            "type": "string"
          },
          "primary_metric": {
            "default": "",
            "title": "Primary Metric",
            "type": "string"
          },
          "primary_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Primary Value"
          },
          "repair_rounds": {
            "default": 0,
            "title": "Repair Rounds",
            "type": "integer"
          }
        },
        "required": [
          "plan_id",
          "model_family",
          "passed"
        ],
        "title": "CandidateSummary",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IntakeGuidance": {
        "additionalProperties": false,
        "description": "一次输入体检的完整结论，同时用于终端提示、API 响应与运行轨迹留证。",
        "properties": {
          "elements": {
            "description": "期望要素清单",
            "items": {
              "type": "string"
            },
            "title": "Elements",
            "type": "array"
          },
          "examples": {
            "description": "可直接复制的合格描述",
            "items": {
              "type": "string"
            },
            "title": "Examples",
            "type": "array"
          },
          "issues": {
            "items": {
              "$ref": "#/components/schemas/IntakeIssue"
            },
            "title": "Issues",
            "type": "array"
          },
          "matched_elements": {
            "description": "已表达要素",
            "items": {
              "type": "string"
            },
            "title": "Matched Elements",
            "type": "array"
          },
          "missing_elements": {
            "description": "缺失要素",
            "items": {
              "type": "string"
            },
            "title": "Missing Elements",
            "type": "array"
          },
          "questions": {
            "description": "针对性追问",
            "items": {
              "type": "string"
            },
            "title": "Questions",
            "type": "array"
          },
          "scenario": {
            "default": "",
            "description": "当前任务场景名",
            "title": "Scenario",
            "type": "string"
          },
          "score": {
            "default": 1.0,
            "description": "要素完备度",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score",
            "type": "number"
          },
          "suggestion": {
            "default": "",
            "description": "一句话建议，如切换场景的命令",
            "title": "Suggestion",
            "type": "string"
          },
          "verdict": {
            "$ref": "#/components/schemas/IntakeVerdict",
            "default": "ok"
          }
        },
        "title": "IntakeGuidance",
        "type": "object"
      },
      "IntakeIssue": {
        "additionalProperties": false,
        "description": "一条具体问题：`code` 供程序判定，`message` / `hint` 给人看。",
        "properties": {
          "code": {
            "description": "问题代码，如 too_short / off_topic / task_mismatch",
            "title": "Code",
            "type": "string"
          },
          "hint": {
            "default": "",
            "description": "怎么改",
            "title": "Hint",
            "type": "string"
          },
          "message": {
            "description": "问题说明",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "IntakeIssue",
        "type": "object"
      },
      "IntakeReviewRequest": {
        "description": "``POST /intake/review`` 请求体：只体检描述，不触发运行。",
        "properties": {
          "spec": {
            "description": "待体检的自然语言能力描述",
            "title": "Spec",
            "type": "string"
          },
          "task_config": {
            "default": "configs/verify_credit.yaml",
            "description": "按该任务的要素与示例体检，如 configs/verify_text.yaml",
            "title": "Task Config",
            "type": "string"
          }
        },
        "required": [
          "spec"
        ],
        "title": "IntakeReviewRequest",
        "type": "object"
      },
      "IntakeVerdict": {
        "description": "输入体检结论。",
        "enum": [
          "ok",
          "clarify",
          "reject"
        ],
        "title": "IntakeVerdict",
        "type": "string"
      },
      "RunRequest": {
        "description": "``POST /run`` 请求体。",
        "properties": {
          "force": {
            "default": false,
            "description": "跳过入口引导拦截；描述被判不可执行时仍强制跑完七步",
            "title": "Force",
            "type": "boolean"
          },
          "mock": {
            "default": false,
            "description": "强制规则模板路径",
            "title": "Mock",
            "type": "boolean"
          },
          "run_id": {
            "default": "api",
            "description": "运行标识，用于产物命名（字母/数字/./_/-，1–64 位，禁止 ..）",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
            "title": "Run Id",
            "type": "string"
          },
          "spec": {
            "description": "自然语言能力描述",
            "title": "Spec",
            "type": "string"
          },
          "task_config": {
            "default": "configs/verify_credit.yaml",
            "description": "任务级验证配置；换场景只改这个字段，核心验证器不变",
            "title": "Task Config",
            "type": "string"
          }
        },
        "required": [
          "spec"
        ],
        "title": "RunRequest",
        "type": "object"
      },
      "RunResponse": {
        "description": "``POST /run`` 响应体，字段取自 ``RunTrace``。",
        "properties": {
          "candidate_count": {
            "title": "Candidate Count",
            "type": "integer"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/CandidateSummary"
            },
            "title": "Candidates",
            "type": "array"
          },
          "intake": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/IntakeGuidance"
              },
              {
                "type": "null"
              }
            ]
          },
          "interpreter_source": {
            "title": "Interpreter Source",
            "type": "string"
          },
          "kg_mode": {
            "title": "Kg Mode",
            "type": "string"
          },
          "passed": {
            "title": "Passed",
            "type": "boolean"
          },
          "repair_count": {
            "title": "Repair Count",
            "type": "integer"
          },
          "report_path": {
            "title": "Report Path",
            "type": "string"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "test_metrics": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": "Test Metrics",
            "type": "object"
          }
        },
        "required": [
          "run_id",
          "passed",
          "interpreter_source",
          "kg_mode",
          "candidate_count",
          "repair_count",
          "candidates",
          "report_path"
        ],
        "title": "RunResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "基于 AI Agent 的算法能力工厂：提交自然语言能力描述，返回生成代码、四层验证结论与图谱沉淀。",
    "title": "AlgoCap Factory API",
    "version": "1.4.4"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "健康检查"
      }
    },
    "/intake/guide": {
      "get": {
        "description": "要素清单、可复制示例、可用场景与已沉淀能力，供前端做输入引导。",
        "operationId": "intake_guide_intake_guide_get",
        "parameters": [
          {
            "in": "query",
            "name": "task_config",
            "required": false,
            "schema": {
              "default": "configs/verify_credit.yaml",
              "title": "Task Config",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Intake Guide Intake Guide Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "能力描述引导菜单"
      }
    },
    "/intake/review": {
      "post": {
        "operationId": "intake_review_intake_review_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IntakeReviewRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntakeGuidance"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "体检一条能力描述（不触发运行）"
      }
    },
    "/run": {
      "post": {
        "operationId": "run_run_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "跑通 a–g 七步闭环"
      }
    },
    "/templates": {
      "get": {
        "operationId": "templates_templates_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "title": "Response Templates Templates Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "已注册算法模板"
      }
    }
  }
}